	<style>
		
		html {
			scroll-behavior:smooth;
		}
		
		body {
			background-image: url("many-kinds-bread-seamless-pattern-gift-wrap-wallpaper-background-kawaii-doodle-flat-cartoon_609998-344.png");
			background-size:contain;
			font-family: "Coiny", system-ui;
			
		}
		
		
		
		h1 {
			color:white;
			font-size:50px;
			
		}
		
		h2 {
			color:white;
			font-size: 40px;
			line-height:50px;
			padding:20px;
			
			
		}
		
		hr {
			height:7px;
			background-color:white;
			border:none;
			margin: 45px auto;
			width:75%;
				
			
			
		}
		
		h3 {
			color:white;
			font-size:35px;
		
		}
		
		p {
			color:white;
		}
		
		banner p {
			font-family: "Borel", cursive;
			font-size:39px;
			font-style:italic;
			/*position:absolute;*/
			text-align:center;
			
			
		}
		
		
		banner {
		background-image:url("dark-melon.png");
		background-size:cover;
			background-repeat:no-repeat;
			background-position:center center;
			border-radius:30px;
			display:block;
			height: 550px;
			width:100%;
			position: relative;
			margin:auto;
			padding-top: 190px;
			box-sizing:border-box;
			text-align:center;
			border:5px solid white;
			
		}
		
		/*banner::before {
			border-radius:30px;
			content: "";
			position:absolute;
			inset:0;
			background: rgba(0,0,0,0.3)
			
		}*/
		
		
		wrapper {
			display:block;
			width:700px;
			margin:auto;
			background-color:lightpink;
			padding:35px;
			text-align:center;
			border: 7px solid #734226;
			border-radius:30px;
			
			
		}
		
		header {
			text-align:center
			
			
		}
		
		nav p {
			background-color:lightgoldenrodyellow;
			padding:20px;
			border: thick solid white;
			border-radius:50px;
			width:23%;
			margin:20px auto;
			display:block;
			font-size:25px;
			vertical-align:center;
			
		}
		
		nav p a {
			color:pink;
			text-decoration:none;
		}
		nav p:hover {
			border: thick solid white;
			background-color:#CDF6F4;
			
		}
		
		nav p:hover a {
			color:white;
		}
		
		div img {
			border-radius:20px;
			width:500px;
			height:500px;
			object-fit:cover;
			object-position:20% 30%;
		
		}
		
		.menu-card {
			
			background-color:white;
			border-radius:30px;
			height:820px;
			width:550px;
			padding-top:20px;
			margin:auto;
			
			
			
		}
		
		.menu-card p {
			
			text-align:center;
			padding: 0 25px 0px 25px;
			font-size:18px;
			color:#734226
			
		}
		
		.drinks {
			object-position:50% 60%;
		}
		
		footer p {
			font-size:15px;
			font-family: "Borel", cursive;
		}
		
		.map {
			border-radius:30px;
			display:block;
			margin:50px;
			width:87%
			
		}
		
		
		section p {
			font-size:20px;
			
		}
		
		.hours h3 {
			
			padding-top:40px;
			text-decoration:underline;
		}
		
		.hours p{
			line-height:20px;
			
		}
		
		.btn {
			text-decoration:none;
			
			display:inline-block;
			width:70px;
			color:pink;
			margin:auto;
			
			font-size:20px;
			border-radius:39px;
			background-color:lightgoldenrodyellow;
			
			padding:20px;
			
			border: 5px solid pink
			
			
			
		}
		
		.btn:hover {
			color:white;
			background-color:#CDF6F4;
			
		}
		
		.socials {
			
			border-radius:30px;
			padding:15px;
			display:inline-block;
		
			
		}
		
		iframe {
			margin:30%
		}
		 
