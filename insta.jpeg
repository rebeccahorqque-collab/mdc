			.drinks {
				display:inline-block;
			}
			
			
			h3 {
				
			}
			
			div img {
				margin:
			}

				
			hr {
			margin: 70px auto;
			width:70%	
			}
			
			.hours p {
				width:200px;
				display:inline-block;
			}
				
			section {
				width: 30%;
				display:inline-block;
				vertical-align:top;
				margin:10px;
				
			}
			
		.menu-card {
			width:100%;
			height:850px;
			}
			
			.menu-card img {
				margin:10px;
				width:90%;
				height:50%
			
				
			}
			
			.menu-card p {
				font-size:16px;
				height:220px;
				width:90%;
				
				
			
			}
			
			.bread {
				object-position: 34%;
			}
		
				
